# ---- Pflicht ----
# Schlüssel für die verschlüsselte Datenablage (AES-256-GCM). Erzeugen mit:
#   openssl rand -hex 32
# NICHT verlieren – ohne ihn sind gespeicherte Registrierungen unlesbar.
DATA_KEY=

# Apple Push (Token-Auth, .p8-Schlüssel aus dem Apple-Developer-Konto)
APNS_KEY_ID=
APNS_TEAM_ID=
# Entweder Pfad zur .p8-Datei (docker-compose bindet ./secrets/AuthKey.p8 ein) ...
# APNS_KEY_FILE=./secrets/AuthKey.p8
# ... oder Inhalt direkt (Zeilenumbrüche als \n):
# APNS_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----

# ---- Dringend empfohlen ----
# Gemeinsames Server-Passwort. Die App schickt es als Header X-Push-Secret
# (in der App unter Einstellungen → Push eintragen). Ist es gesetzt, werden
# Anfragen ohne passendes Passwort mit 401 abgelehnt.
PUSH_SHARED_SECRET=

# Domain für Caddy (docker-compose), z. B. push.example.com
PUSH_DOMAIN=

# ---- Optional ----
# Fester APNs-Topic (Bundle-ID der App). Leer = bundleId aus der Registrierung.
# APNS_TOPIC=com.jakober.blockmail
# Nur diese Bundle-IDs zulassen (kommagetrennt; gilt, wenn APNS_TOPIC leer ist)
# APNS_ALLOWED_TOPICS=com.jakober.blockmail
# PORT=8787
# HOST=0.0.0.0
# DATA_DIR=./data
# LOG_LEVEL=info            # debug | info | warn | error
# MAX_REGISTRATIONS=500
# MAX_ACCOUNTS_PER_DEVICE=10
# REGISTRATION_TTL_DAYS=90  # nicht erneuerte Registrierungen löschen
# MAX_BACKLOG_NOTIFICATIONS=5
# IDLE_RENEW_MINUTES=25
# TRUST_PROXY=1             # X-Forwarded-For auswerten (hinter Caddy/Traefik)
# ALLOW_PRIVATE_IMAP_HOSTS=0  # 1 = auch IMAP-Server im internen Netz erlauben
