"tour_step_ai_text" = "Der KI-Knopf fasst deinen ganzen Tag oder alle ungelesenen Mails auf einen Blick zusammen. Alle KI-Funktionen sind Teil von BlockMail Pro: 3 Tage kostenlos testen, danach ab 5,99 € im Monat (150 KI-Anfragen) oder 10,99 € (300 Anfragen).";
"tour_step_ai_title" = "Dein KI-Assistent";
"tour_step_attachments_text" = "Tippe auf den Ordner-Namen: Hier wechselst du Ordner und Konten — und findest „Anhänge“. Dort liegen Bilder, PDFs und Dokumente aus allen Mails gebündelt in einer Galerie. Einen Anhang in der Mail antippen bietet außerdem „Unterschreiben & zurückschicken“ an.";
"tour_step_attachments_title" = "Alle Anhänge an einem Ort";
"tour_step_compose_text" = "Mit dem Stift beginnst du eine neue Mail — auf Wunsch hilft dir die KI beim Formulieren.";
"tour_step_compose_title" = "Neue Mail schreiben";
"tour_step_extras_text" = "BlockMail warnt vor Phishing, erinnert mit dem Antwort-Radar an unbeantwortete Mails, zeigt Statistiken — und ist ein kompletter PDF-Editor: unterschreiben, markieren, schwärzen, Seiten ordnen. Du kannst BlockMail sogar als Standard-PDF-App festlegen. Alle Zusatzfunktionen findest du in den Einstellungen.";
"tour_step_extras_title" = "Noch mehr drin";
"tour_step_menu_text" = "Mit dem linken Symbol wechselst du direkt zwischen Liste und Kacheln. Daneben das Menü — hier geöffnet: Hell/Dunkel, Ansicht, schlichtes Design, Schriftgröße und die Einstellungen.";
"tour_step_menu_title" = "Ansicht & Menü";
"tour_step_theme_text" = "Mit dem Sonne/Mond-Symbol wechselst du zwischen Hell und Dunkel. Die Farbpalette daneben schaltet durch die Farbschemata der App.";
