    <string name="setup_choose_provider">Wähle deinen E-Mail-Anbieter</string>
    <string name="setup_choose_provider_desc">Server und Ports stellt BlockMail automatisch ein — du brauchst nur E-Mail-Adresse und Passwort.</string>
