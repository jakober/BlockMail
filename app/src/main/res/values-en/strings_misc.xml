<resources>
    <!-- WelcomeScreen -->
    <string name="welcome_title">Welcome to BlockMail</string>
    <string name="welcome_subtitle">The clear, fast mail app.</string>
    <string name="welcome_feature_blocks_title">Focus blocks</string>
    <string name="welcome_feature_blocks_text">Your inbox sorts itself by importance: Needs reply, Important, Can wait, Promotions — as clear tiles.</string>
    <string name="welcome_feature_phishing_title">Phishing guard</string>
    <string name="welcome_feature_phishing_text">Detects scam emails right on your device and warns you with a red border — no data leaves your phone.</string>
    <string name="welcome_feature_radar_title">Reply radar</string>
    <string name="welcome_feature_radar_text">Reminds you of open questions in your mailbox — and when you\'ve been waiting too long for a reply yourself.</string>
    <string name="welcome_feature_push_title">New mail instantly</string>
    <string name="welcome_feature_push_text">Real-time push with quick reply straight from the notification.</string>
    <string name="welcome_feature_accounts_title">All accounts, one overview</string>
    <string name="welcome_feature_accounts_text">Multiple mailboxes with their own colors — separately or combined.</string>
    <string name="welcome_feature_ai_title">AI that stays on your device</string>
    <string name="welcome_feature_ai_text">Summarize, draft replies, daily overview and newsletter tidying.</string>
    <string name="welcome_setup">Set up account</string>
    <string name="welcome_skip">Explore later</string>

