    <!-- Real-time push -->
    <string name="settings_group_notifications">Notifications</string>
    <string name="settings_push_title">Real-time push</string>
    <string name="settings_push_subtitle">Instant notifications for new emails</string>
    <string name="settings_push_restart">Restart service</string>
    <string name="settings_push_restarted">Push service restarted</string>
    <string name="settings_battery_exempt">Grant battery exemption</string>
    <string name="settings_battery_manual">Please allow it manually in the battery settings</string>
    <string name="settings_battery_tip">Tip: the battery exemption keeps Android from dropping the push connection in standby.</string>
    <string name="settings_eco_title">Eco mode — no persistent notification</string>
    <string name="settings_eco_desc">Instead of keeping a permanent connection, BlockMail checks for new emails about every 15 minutes. The silent service notification goes away; notifications may be delayed by up to 15 minutes.</string>
    <string name="settings_eco_on_snack">Eco mode on — checking about every 15 minutes</string>
    <string name="settings_push_on_snack">Real-time push is back on</string>
    <string name="settings_notif_buttons">Buttons in the notification</string>
    <string name="settings_notif_buttons_desc">Which actions appear directly in the notification for a new email. Android shows at most 3. Change the order by dragging the handle on the right.</string>
    <string name="settings_notif_reply">Reply (with inline input)</string>
    <string name="settings_notif_read">Mark as read</string>
    <string name="settings_notif_max3">A maximum of 3 buttons is possible — please deselect one first</string>
    <string name="settings_notif_drag">Drag to change position</string>
    <string name="settings_radar_title">Reply radar</string>
    <string name="settings_radar_desc">Reminds you once a day about emails with an open question you haven\'t answered yet — and tells you when you\'ve been waiting days for a reply yourself. Applies only to real people: senders from your contacts or VIPs, never to automated or system emails.</string>

