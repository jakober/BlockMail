    <!-- Account management -->
    <string name="settings_accounts_title">Accounts</string>
    <string name="settings_accounts_subtitle">Your mailboxes: color and visible folders per account</string>
    <string name="settings_accounts_desc">Switch between accounts via the folder menu at the top of the inbox. “Pick color” gives the account its own color — it appears as a bar at the front of every email from that account. “Visible folders” controls which folders the account shows in the folder menu.</string>
